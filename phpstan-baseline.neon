parameters:
	ignoreErrors:
		-
			message: '#^Cannot call method matches\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 2
			path: src/Condition.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, Closure\(Utopia\\WAF\\Condition\)\: array\{method\: string, attribute\?\: string, values\: array\<mixed\>\} given\.$#'
			identifier: argument.type
			count: 1
			path: src/Condition.php

		-
			message: '#^Parameter \#1 \$payload of static method Utopia\\WAF\\Condition\:\:fromArray\(\) expects array\<string, mixed\>, array\<mixed, mixed\> given\.$#'
			identifier: argument.type
			count: 3
			path: src/Condition.php

		-
			message: '#^Strict comparison using \!\=\= between string and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: src/Firewall.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Validator/Conditions.php

		-
			message: '#^Parameter \#1 \$payload of method Utopia\\WAF\\Validator\\Conditions\:\:isValidCondition\(\) expects array\<string, mixed\>\|string, array\<mixed, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Validator/Conditions.php

		-
			message: '#^Parameter \#1 \$payload of method Utopia\\WAF\\Validator\\Conditions\:\:isValidCondition\(\) expects array\<string, mixed\>\|string, array\<mixed, mixed\>\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Validator/Conditions.php

		-
			message: '#^Instanceof between Utopia\\WAF\\Rules\\RateLimit and Utopia\\WAF\\Rules\\RateLimit will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: tests/FirewallTest.php
